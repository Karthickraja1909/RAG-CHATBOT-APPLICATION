# ═══════════════════════════════════════════════════════════════════
# GenAI RAG System - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────
APP_NAME=GenAI RAG System
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ─── OpenAI Configuration ─────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=1024

# ─── OpenRouter (Optional - alternative LLM provider) ────────────
# Set USE_OPENROUTER=true to route all LLM calls through OpenRouter
USE_OPENROUTER=false
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large

# ─── Azure OpenAI (Optional - uncomment if using Azure) ──────────
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ─── Vector Store ─────────────────────────────────────────────────
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=data/vector_store/faiss_index
EMBEDDING_DIMENSION=3072
SIMILARITY_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# ─── Document Ingestion ──────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SUPPORTED_FILE_TYPES=.pdf,.txt,.md,.docx,.csv
DOCUMENTS_DIRECTORY=data/documents
MAX_FILE_SIZE_MB=50

# ─── RAG Pipeline ────────────────────────────────────────────────
RETRIEVAL_STRATEGY=similarity
RERANKING_ENABLED=false
CONTEXT_WINDOW_SIZE=4096
SYSTEM_PROMPT_PATH=config/prompts/system_prompt.txt

# ─── Evaluation ──────────────────────────────────────────────────
EVAL_MODEL=gpt-4o-mini
EVAL_EMBEDDING_MODEL=text-embedding-3-small
EVAL_THRESHOLD=0.7
EVAL_DATASET_PATH=data/evaluation/eval_dataset.json
EVAL_RESULTS_PATH=data/evaluation/results
EVAL_BATCH_SIZE=10

# ─── DeepEval ────────────────────────────────────────────────────
DEEPEVAL_METRICS=answer_relevancy,faithfulness,contextual_precision,contextual_recall,hallucination
DEEPEVAL_THRESHOLD=0.7

# ─── RAGAS ───────────────────────────────────────────────────────
RAGAS_METRICS=faithfulness,answer_relevancy,context_precision,context_recall
RAGAS_THRESHOLD=0.7

# ─── CI/CD & Reporting ───────────────────────────────────────────
REPORT_FORMAT=json
ARTIFACT_DIRECTORY=artifacts
FAIL_ON_THRESHOLD_BREACH=true

# ─── Evaluation Automation ───────────────────────────────────────
# Frameworks to run: deepeval,ragas (comma-separated)
EVAL_FRAMEWORKS=deepeval,ragas
# Run RAG pipeline on eval dataset before evaluation
EVAL_RUN_RAG_PIPELINE=true
# Enable custom production metrics (bias, toxicity, coherence, completeness, conciseness)
EVAL_CUSTOM_METRICS_ENABLED=true
# Auto-generate eval dataset from ingested documents (set true for dynamic datasets)
EVAL_AUTO_GENERATE_DATASET=false

# ─── Email Notifications ─────────────────────────────────────────
# Set EMAIL_ENABLED=true to auto-send evaluation reports via email
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your-email@gmail.com
EMAIL_SENDER_PASSWORD=your-app-password-here
# Comma-separated list of recipients
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
EMAIL_SUBJECT_PREFIX=[GenAI RAG Eval]