# ═══════════════════════════════════════════════════════════════════
# GenAI RAG System - Environment Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────
APP_NAME=GenAI RAG System
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ─── OpenAI Configuration ─────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=256

# ─── OpenRouter (Optional - alternative LLM provider) ────────────
# Set USE_OPENROUTER=true to route all LLM calls through OpenRouter
USE_OPENROUTER=false
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ─── Azure OpenAI (Optional - uncomment if using Azure) ──────────
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ─── Vector Store ─────────────────────────────────────────────────
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=data/vector_store/faiss_index
EMBEDDING_DIMENSION=1536
SIMILARITY_TOP_K=8
SIMILARITY_THRESHOLD=0.25

# ─── Document Ingestion ──────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SUPPORTED_FILE_TYPES=.pdf,.txt,.md,.docx,.csv
DOCUMENTS_DIRECTORY=data/documents
MAX_FILE_SIZE_MB=50

# ─── RAG Pipeline ────────────────────────────────────────────────
RETRIEVAL_STRATEGY=similarity
CONTEXT_WINDOW_SIZE=4096
SYSTEM_PROMPT_PATH=config/prompts/system_prompt.txt

# ─── Reranker (Reduces retrieval noise → improves ContextualPrecision) ─
# Enable LLM-based reranking: scores each chunk for query relevance,
# drops irrelevant ones, and re-orders by relevance before generation.
RERANKING_ENABLED=true
# Model used for reranking (lightweight model recommended for speed)
RERANKER_MODEL=openai/gpt-oss-120b:free
# Number of chunks to keep after reranking (must be <= SIMILARITY_TOP_K)
RERANKER_TOP_N=4
# Minimum relevance score (0.0-1.0). Chunks scoring below this are dropped.
RERANKER_RELEVANCE_THRESHOLD=0.5

# ─── Evaluation ──────────────────────────────────────────────────
EVAL_MODEL=openai/gpt-oss-120b:free
EVAL_EMBEDDING_MODEL=openai/text-embedding-3-small
EVAL_THRESHOLD=0.7
EVAL_DATASET_PATH=data/evaluation/eval_dataset.json
EVAL_RESULTS_PATH=data/evaluation/results
EVAL_BATCH_SIZE=10

# ─── DeepEval ────────────────────────────────────────────────────
DEEPEVAL_METRICS=answer_relevancy,faithfulness,contextual_precision,contextual_recall,hallucination
DEEPEVAL_THRESHOLD=0.7

# ─── RAGAS ───────────────────────────────────────────────────────
RAGAS_METRICS=faithfulness,answer_relevancy,context_precision,context_recall
RAGAS_THRESHOLD=0.7

# ─── CI/CD & Reporting ───────────────────────────────────────────
REPORT_FORMAT=json
ARTIFACT_DIRECTORY=artifacts
FAIL_ON_THRESHOLD_BREACH=true

# ─── Evaluation Automation ───────────────────────────────────────
# Frameworks to run: deepeval,ragas (comma-separated)
EVAL_FRAMEWORKS=deepeval,ragas
# Run RAG pipeline on eval dataset before evaluation
EVAL_RUN_RAG_PIPELINE=true
# Enable custom production metrics (bias, toxicity, coherence, completeness, conciseness)
EVAL_CUSTOM_METRICS_ENABLED=true
# Auto-generate eval dataset from ingested documents (set true for dynamic datasets)
EVAL_AUTO_GENERATE_DATASET=false

# ─── Testset Generation ──────────────────────────────────────────
# Strategy: ragas (enterprise recommended), document (chunk-based LLM), hybrid (both merged)
TESTSET_STRATEGY=ragas
# Number of test cases to generate
TESTSET_SIZE=20

# ─── Hybrid Search (BM25 + Dense Vectors) ────────────────────────
# Combines keyword matching with semantic search for better recall
HYBRID_SEARCH_ENABLED=false
# Alpha weight: 1.0 = pure dense, 0.0 = pure BM25, 0.5 = balanced
HYBRID_SEARCH_ALPHA=0.5

# ─── Response Cache (In-Memory) ──────────────────────────────────
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_MAX_SIZE=256
RESPONSE_CACHE_TTL_SECONDS=3600

# ─── Embedding Cache ─────────────────────────────────────────────
# Avoids re-embedding identical text across ingestion runs
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_MAX_SIZE=2048

# ─── Follow-up Questions ─────────────────────────────────────────
# Auto-suggest related questions after each answer
FOLLOWUP_ENABLED=true
FOLLOWUP_COUNT=3

# ─── Metadata Enrichment ─────────────────────────────────────────
# Auto-tag documents with department, topic, author using LLM during ingestion
METADATA_ENRICHMENT_ENABLED=false

# ─── FastAPI Server ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Connection Pooling ──────────────────────────────────────────
LLM_CONNECTION_POOL_SIZE=10
LLM_REQUEST_TIMEOUT=60

# ─── Structured Logging ──────────────────────────────────────────
# Set LOG_FILE to enable JSON structured logging to file
# LOG_FILE=logs/app.log

# ─── Email Notifications ─────────────────────────────────────────
# Set EMAIL_ENABLED=true to auto-send evaluation reports via email
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your-email@gmail.com
EMAIL_SENDER_PASSWORD=your-app-password-here
# Comma-separated list of recipients
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
EMAIL_SUBJECT_PREFIX=[GenAI RAG Eval]